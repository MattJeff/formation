# ============================================
# 🌐 APPLICATION URL
# ============================================
# URL de votre application (sans slash final)
# Development: http://localhost:3000
# Production: https://votredomaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# 🗄️ SUPABASE
# ============================================
# Récupérez ces valeurs dans votre dashboard Supabase
# Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://votreprojet.supabase.co

# Settings > API > Project API keys > anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key_ici

# ============================================
# 💳 STRIPE
# ============================================
# Dashboard Stripe > Developers > API keys
# Mode TEST pour développement
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# 📧 RESEND (Email)
# ============================================
# Dashboard Resend > API Keys
RESEND_API_KEY=re_...

# ============================================
# 🔒 SENTRY (Error tracking - optionnel)
# ============================================
SENTRY_AUTH_TOKEN=votre_token_sentry
