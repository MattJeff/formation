# ============================================
# 🔍 SENTRY CONFIGURATION
# ============================================
# Variables d'environnement pour Sentry monitoring
#
# Instructions:
# 1. Créer un compte sur https://sentry.io
# 2. Créer un nouveau projet Next.js
# 3. Copier le DSN fourni
# 4. Ajouter ces variables à votre .env.local (dev) et Vercel (prod)
# ============================================

# DSN Client (public - safe to expose)
# Format: https://[key]@[organization].ingest.sentry.io/[project-id]
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# DSN Server (private - keep secret)
SENTRY_DSN=your_sentry_dsn_here

# Organization slug (from Sentry dashboard)
SENTRY_ORG=your-organization-slug

# Project name (from Sentry dashboard)
SENTRY_PROJECT=your-project-name

# Auth Token (for uploading source maps)
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# Scopes needed: project:releases, org:read
SENTRY_AUTH_TOKEN=your_auth_token_here

# ============================================
# 📝 NOTES
# ============================================
# - Le DSN client est exposé au navigateur (normal)
# - Le DSN serveur reste privé
# - L'auth token est uniquement pour le build (upload source maps)
# - En dev, Sentry est désactivé (voir sentry.*.config.ts)
# - En production, tous les événements sont capturés
# ============================================
